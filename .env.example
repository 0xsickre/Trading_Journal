# Supabase project — both values are PUBLIC by design.
#
# The anon key is safe in the browser because every table is protected by
# row-level security, not by the key being secret. It grants no access on its
# own: policies filter every row by `user_id = auth.uid()`, so a signed-out
# holder of this key can read nothing.
#
# Never put the SERVICE ROLE key here or anywhere in this repo — that one
# bypasses RLS entirely.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# cTrader Open API — Faza 8B (automatski MAE/MFE). App registrovana na
# openapi.ctrader.com, scope "Access info on your accounts" (read-only).
CTRADER_CLIENT_ID=<client id>
CTRADER_CLIENT_SECRET=<client secret>
